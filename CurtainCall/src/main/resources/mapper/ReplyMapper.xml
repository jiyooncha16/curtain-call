<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.curtaincall.reply.mapper.ReplyMapper">

    <!-- 전체 댓글 조회 -->
    <select id="selectAllReply" resultType="Reply">
  SELECT * FROM reply
  WHERE board_id = #{boardId}
  ORDER BY reply_id ASC
    </select>


    <!-- 댓글 등록 -->
    <insert id="insertReply" parameterType="Reply" useGeneratedKeys="true" keyProperty="replyId">
        INSERT INTO reply(content, create_date, board_id, user_id)
        VALUES(#{content}, NOW(), #{boardId}, #{userId})
    </insert>

    <!-- 댓글 수정 -->
    <update id="updateReply" parameterType="Reply">
        UPDATE reply
        SET content = #{content}
        WHERE reply_id = #{replyId}
    </update>

    <!-- 댓글 삭제 -->
    <delete id="deleteReply" parameterType="int">
        DELETE FROM reply
        WHERE reply_id = #{id}
    </delete>

</mapper>
