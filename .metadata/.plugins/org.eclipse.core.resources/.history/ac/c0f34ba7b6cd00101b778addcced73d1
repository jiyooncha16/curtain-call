<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.ssafy.curtaincall.musical.mapper.TheaterMapper">

	<!-- 전체 리스트 조회-->
	<select id="selectAllTheater" resultType="Theater">
		SELECT * FROM theater
	</select>
	
	<!-- 개별 항목 조회 -->
	<select id="selectMusical" parameterType="String" resultType="Musical">
		SELECT * FROM theater
		WHERE theater = #{theater}
	</select>
	
</mapper>